subscription_id = "00000000-0000-0000-0000-000000000000"
name            = "your-unique-hub"
location        = "eastus2"
owner           = "your-team"
image           = "ghcr.io/your-org/replica-hub@sha256:REPLACE_WITH_REAL_DIGEST"

