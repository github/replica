#!/usr/bin/env ruby

require_relative "../lib/dependency_age_policy"

root = ENV.fetch("DEPENDENCY_AGE_ROOT", File.expand_path("..", __dir__))
excluded_paths = ENV.fetch("DEPENDENCY_AGE_EXCLUDED_PATHS", "").split(File::PATH_SEPARATOR).reject(&:empty?)
result = DependencyAgePolicy::Audit.new(root:, excluded_paths:).call
puts result
exit 1 unless result.success?
