{
  "name": "replica-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "controls:build": "node script/build-controls-bridge.mjs",
    "controls:assets:check": "node script/build-controls-bridge.mjs --check",
    "controls:test": "node --test script/tests/build-controls.test.mjs",
    "controls:runtime:test": "node --test app/javascript/utils/prototype-controls/*.test.mjs",
    "controls:schema:generate": "node app/javascript/utils/prototype-controls/generate-controls-validator.mjs",
    "controls:schema:check": "node app/javascript/utils/prototype-controls/generate-controls-validator.mjs --check",
    "build": "npm run typecheck && vite build",
    "dev": "vite dev",
    "extension:assets:check": "node ../.github/extensions/replica-prototype/check-assets/index.mjs",
    "extension:build": "npm run extension:modules:build && vite build --config vite.prototype-canvas.config.mjs && node script/build-prototype-preview-bridge.mjs",
    "extension:modules:build": "node script/build-extension-modules.mjs",
    "extension:test": "npm run controls:runtime:test && node --test ../.github/extensions/replica-prototype/**/*.test.mjs",
    "format": "prettier --write .",
    "lint": "eslint . ../.github/extensions/replica-prototype ../packages/learning && prettier --check . '../eslint.config.mjs' '../.github/extensions/replica-prototype/**/*.{mjs,mts,ts}' '../.github/extensions/replica-prototype/*.json' '../packages/learning/**/*.{mjs,mts,json}' --config .prettierrc.json",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 0.0.0.0 --port 6006 --initial-path /story/hub-design-overview--taxonomy",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project ../.github/extensions/replica-prototype/tsconfig.json"
  },
  "dependencies": {
    "@primer/octicons-react": "19.40.0",
    "@primer/react-brand": "0.78.0",
    "@rails/actioncable": "8.1.400",
    "@reduxjs/toolkit": "2.13.0",
    "@thoughtbot/superglue": "1.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/rails__actioncable": "8.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "storybook": "10.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-ruby": "5.2.5",
    "vitest": "5.0.3"
  }
}
