{
  "name": "replica-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "jobs:setup": "node server/setup-jobs/index.ts",
    "setup": "npm run db:deploy && npm run jobs:setup",
    "worker:on-demand": "node server/workers/index.ts on-demand",
    "worker:scheduled": "node server/workers/index.ts scheduled",
    "start:worker:on-demand": "node dist/server/workers/index.js on-demand",
    "start:worker:scheduled": "node dist/server/workers/index.js scheduled",
    "start:jobs:setup": "node dist/server/setup-jobs/index.js",
    "start:setup": "npm run db:deploy && npm run start:jobs:setup",
    "controls:build": "node script/build-controls-bridge.mjs",
    "controls:assets:check": "node script/build-controls-bridge.mjs --check",
    "controls:test": "node --test script/tests/build-controls.test.mjs",
    "controls:runtime:test": "node --test app/javascript/utils/prototype-controls/*.test.mjs",
    "controls:schema:generate": "node app/javascript/utils/prototype-controls/generate-controls-validator.mjs",
    "controls:schema:check": "node app/javascript/utils/prototype-controls/generate-controls-validator.mjs --check",
    "build": "npm run typecheck && vite build && tsc --project tsconfig.server.json",
    "dev": "npm run dev:client",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.ts",
    "start": "node dist/server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "extension:assets:check": "node ../.github/extensions/replica-prototype/check-assets/index.mjs",
    "extension:build": "npm run extension:modules:build && vite build --config vite.prototype-canvas.config.mjs && node script/build-prototype-preview-bridge.mjs",
    "extension:modules:build": "node script/build-extension-modules.mjs",
    "extension:test": "npm run controls:runtime:test && node --test ../.github/extensions/replica-prototype/**/*.test.mjs",
    "format": "prettier --write .",
    "lint": "eslint . ../.github/extensions/replica-prototype ../packages/learning && prettier --check . '../eslint.config.mjs' '../.github/extensions/replica-prototype/**/*.{mjs,mts,ts}' '../.github/extensions/replica-prototype/*.json' '../packages/learning/**/*.{mjs,mts,json}' --config .prettierrc.json",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --host 0.0.0.0 --port 6006 --initial-path /story/hub-design-overview--taxonomy",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir storybook-static",
    "test": "vitest run --project=node --project=browser",
    "test:database": "vitest run --project=node-database --project=browser-database --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --project ../.github/extensions/replica-prototype/tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@primer/octicons-react": "19.40.0",
    "@primer/react-brand": "0.78.0",
    "bullmq": "6.4.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/express": "5.0.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "storybook": "10.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
