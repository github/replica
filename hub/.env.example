# Optional API port. The Vite development proxy expects the default.
PORT=3001

# API logging threshold: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Public browser origin. Production requires HTTPS; local HTTP must use loopback.
HUB_ORIGIN=http://127.0.0.1:5173

# Keep 0 unless the API is reachable only through this exact number of trusted proxies.
HUB_TRUSTED_PROXY_HOPS=0

# Local development only. The devcontainer supplies its own database hostname.
DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/replica

# Only database-enabled tests require this URL and CREATEDB permission.
TEST_DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/postgres

# GitHub user authorization is optional until both values are configured.
# These credentials establish user identity and are separate from source integration.
# HUB_GITHUB_AUTH_CLIENT_ID=
# HUB_GITHUB_AUTH_CLIENT_SECRET=

# GitHub proves identity by default. Select legacy-repository only for compatibility.
HUB_ADMISSION_POLICY=hub-managed

# Select the GitHub source-integration credential provider. See docs/identity.md.
HUB_GITHUB_CREDENTIAL_PROVIDER=database

# Generate separate values outside the database. See docs/identity.md.
# HUB_GITHUB_CREDENTIAL_KEY=<openssl rand -hex 32>

# The environment provider is read-only and requires every source-integration setting below.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=
