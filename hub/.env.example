# Optional API port. The Vite development proxy expects the default.
PORT=3001

# API logging threshold: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Public browser origin. Production requires HTTPS; local HTTP must use loopback.
HUB_ORIGIN=http://127.0.0.1:5173

# Select one user sign-in provider. Omit only to retain the existing optional GitHub setup.
# HUB_AUTH_PROVIDER=oidc

# Standards-based OIDC. The first documented profile is single-tenant Microsoft Entra ID.
# The credential reference names another environment variable; Hub never stores the secret.
# HUB_OIDC_ENABLED=true
# HUB_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# HUB_OIDC_CLIENT_ID=
# HUB_OIDC_CALLBACK_URL=https://hub.example.com/api/auth/oidc/callback
# HUB_OIDC_CLIENT_CREDENTIAL_REFERENCE=HUB_OIDC_CLIENT_SECRET
# HUB_OIDC_CLIENT_SECRET=
# HUB_OIDC_MEMBER_ROLE=Hub.User
# HUB_OIDC_ADMINISTRATOR_ROLE=Hub.Administrator
# HUB_OIDC_SCOPES=openid profile email
# HUB_OIDC_MEMBERSHIP_POLICY=jit-assignment
# HUB_OIDC_PROVIDER_REVISION=1

# Keep 0 unless the API is reachable only through this exact number of trusted proxies.
HUB_TRUSTED_PROXY_HOPS=0

# Local development only. The devcontainer supplies its own database hostname.
DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/replica

# Only database-enabled tests require this URL and CREATEDB permission.
TEST_DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/postgres

# Local reference artifact storage. The default is ~/.replica/artifacts, outside the checkout.
# Production deployments should mount durable storage here.
# HUB_ARTIFACT_STORAGE_PATH=/var/lib/replica/artifacts

# GitHub user authorization is optional until both values are configured.
# These credentials establish user identity and are separate from source integration.
# HUB_GITHUB_AUTH_CLIENT_ID=
# HUB_GITHUB_AUTH_CLIENT_SECRET=

# GitHub proves identity by default. github-synchronized admits users through explicitly
# linked repository sources. legacy-repository preserves the earlier compatibility behavior.
HUB_ADMISSION_POLICY=hub-managed

# Generate separate host-held values. Bootstrap can enroll the first administrator once.
# Recovery works only when no active administrator remains and never reopens bootstrap.
# HUB_BOOTSTRAP_SECRET=<openssl rand -hex 32>
# HUB_ADMIN_RECOVERY_SECRET=<openssl rand -hex 32>

# Select the GitHub source-integration credential provider. See docs/identity.md.
HUB_GITHUB_CREDENTIAL_PROVIDER=database

# Generate separate values outside the database. See docs/identity.md.
# HUB_GITHUB_CREDENTIAL_KEY=<openssl rand -hex 32>

# The environment provider is read-only and requires every source-integration setting below.
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=

# Required only for /api/github/webhooks. Keep it separate from user-auth credentials.
# HUB_GITHUB_WEBHOOK_SECRET=<GitHub App webhook secret>
