# Optional API port. The Vite development proxy expects the default.
PORT=3001
HOST=127.0.0.1

# The image defaults to combined; development starts the API alone.
RUNTIME_MODE=api
SHUTDOWN_TIMEOUT_MS=30000
# CLIENT_DIRECTORY=/absolute/path/to/dist/client

# API logging threshold: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Explicit spans only. See docs/telemetry.md before enabling export.
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Independent worker concurrency. Both default to one (supported range: 1-100).
ON_DEMAND_JOB_CONCURRENCY=1
SCHEDULED_JOB_CONCURRENCY=1

# Optional storage foundation. Choose one provider; see docs/artifact-storage.md.
# ARTIFACT_STORAGE_PROVIDER=filesystem
# ARTIFACT_STORAGE_DIRECTORY=/absolute/service-owned/artifacts
# For Azure, use provider azure and omit ARTIFACT_STORAGE_DIRECTORY:
# AZURE_STORAGE_ACCOUNT=youraccount
# AZURE_STORAGE_CONTAINER=artifacts
# AZURE_CLIENT_ID=your-user-assigned-managed-identity-uuid

# Optional simple/local Copilot credential provider. No production provider is configured by default.
# REPLICA_COPILOT_AUTHENTICATION=ambient-cli
# Or use environment-token together with the secret below:
# REPLICA_COPILOT_AUTHENTICATION=environment-token
# REPLICA_COPILOT_TOKEN=
# REPLICA_LEARNING_ROOT=storage/learning
# REPLICA_LEARNING_CLI=../packages/learning/bin/replica-learning.mjs
# REPLICA_LEARNING_NODE=/absolute/path/to/node

# Local development only. The devcontainer supplies its own database hostname.
# Run `npm run setup` before starting a database-backed API.
DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/replica

# Only database-enabled tests require this URL and CREATEDB permission.
TEST_DATABASE_URL=postgresql://replica:replica@127.0.0.1:5432/postgres

# --- Required shared settings ---
# Set these and at least one complete provider profile. `npm run env:init` generates the
# encryption key and bootstrap secret without replacing existing values.
# HUB_APPLICATION_ORIGIN=http://127.0.0.1:5173
# Generate 32 random bytes and encode them as base64.
# HUB_AUTHENTICATION_ENCRYPTION_KEY=
# Use a random value containing at least 32 characters.
# HUB_BOOTSTRAP_SECRET=

# --- GitHub App sign-in ---
# Open /settings/github/setup for the callback URL and each value's source. Deployed Hubs
# read the client secret, private key, and webhook secret from Key Vault instead.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Increment for an intentional provider configuration or credential generation change and
# before re-enabling GitHub after it was removed.
# GITHUB_PROVIDER_REVISION=1

# --- GitHub App identity ---
# Used for repository access and webhooks. Add the downloaded key with
# `npm run env:init -- --private-key path/to/app.private-key.pem`.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_BASE64=
# GITHUB_WEBHOOK_SECRET=

# --- Microsoft Entra sign-in ---
# Optional single-tenant sign-in.
# ENTRA_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-uuid>/v2.0
# ENTRA_OIDC_CLIENT_ID=<application-client-id>
# Increment for intentional configuration or credential changes. A new revision invalidates
# in-flight attempts, stale replicas, and old-revision provider authority and sessions.
# Re-enabling a removed provider requires the next revision. Keep the revision unchanged for
# a restart with the same validated enabled settings.
# ENTRA_OIDC_PROVIDER_REVISION=1
# Local/test:
# ENTRA_OIDC_CLIENT_AUTHENTICATION=client-secret
# ENTRA_OIDC_CLIENT_SECRET=
# Governed user-assigned managed identity:
# ENTRA_OIDC_CLIENT_AUTHENTICATION=managed-identity
# ENTRA_OIDC_MANAGED_IDENTITY_CLIENT_ID=<managed-identity-client-id>

# Development-only sign-in as one local administrator, without GitHub or Entra.
# `npm run dev:api` defaults NODE_ENV to development and enables local sign-in.
# `npm run dev:api:live` disables local sign-in. These values are for running
# server/index.ts directly. Requires the local DATABASE_URL above.
# See docs/development.md.
# NODE_ENV=development
# HUB_LOCAL_SIGN_IN=true

# Trust forwarded client addresses only behind this exact protected proxy-chain length.
# HUB_TRUSTED_PROXY_HOPS=0
