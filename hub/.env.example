REPLICA_HUB_ORIGIN=http://replica.localhost:19500
REPLICA_PREVIEW_ORIGIN_TEMPLATE=http://b{build_id}.preview.replica.localhost:19500
REPLICA_SHARE_PREVIEW_ORIGIN_TEMPLATE=http://s{build_id}.preview.replica.localhost:19500
# Hub uses the reviewed Action pin in config/build_action_releases by default.
# Override only when using a different reviewed Action repository.
# REPLICA_BUILD_ACTION=owner/repo/actions/build@REVIEWED_COMMIT
REPLICA_ARTIFACT_STORE=local
REPLICA_ARTIFACT_ROOT=storage/artifacts
# Azure deployments use these instead of REPLICA_ARTIFACT_ROOT.
# REPLICA_ARTIFACT_STORE=azure
# REPLICA_AZURE_STORAGE_ACCOUNT=
# REPLICA_AZURE_STORAGE_CONTAINER=
# REPLICA_AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Learnings asks Copilot with this token: a fine-grained personal access token whose only
# permission is Copilot requests. Hub never stores it. See docs/copilot.md.
# REPLICA_COPILOT_TOKEN=
# To bill the organization that installed Hub's GitHub App instead of the token's owner, give the
# App the Copilot requests organization permission and set this. Hub then ignores the token.
# REPLICA_COPILOT_BILLING=organization
# Use a non-empty secret. A long random value is recommended for public deployments.
REPLICA_BOOTSTRAP_SECRET=
# Production deployments should set independent random values for these keys.
REPLICA_DATABASE_ENCRYPTION_PRIMARY_KEY=
REPLICA_DATABASE_ENCRYPTION_DETERMINISTIC_KEY=
REPLICA_DATABASE_ENCRYPTION_KEY_DERIVATION_SALT=
