json.pageTitle t("prototypes.show.page_title", branch: @prototype.branch_name)
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.partial! partial: "shared/hub_administration_navigation"
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutPath session_path
json.authenticityToken form_authenticity_token
json.mentionCandidatesPath repository_prototype_mention_candidates_path(@repository.route_id, @prototype)
json.initialCommentId params[:comment].to_i if params[:comment].is_a?(String) && params[:comment].match?(/\A[1-9]\d*\z/)
json.initialNotificationId params[:notification].to_i if params[:notification].is_a?(String) && params[:notification].match?(/\A[1-9]\d*\z/)
json.notificationErrorLabel t("notifications.error")
json.mentionCopy do
  json.suggestions t("notifications.suggestions")
  json.error t("notifications.suggestions_error")
  json.loading t("notifications.suggestions_loading")
  json.empty t("notifications.suggestions_empty")
  json.retry t("prototypes.show.review_comments.retry")
  json.limit t("notifications.mention_limit")
end

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.repositorySelectorLabel t \
  "repository_workspace.repository_selector",
  repository: @repository.name_with_owner
json.repositoryMenuLabel t("repository_workspace.repositories")
json.navigationLabel t("repository_workspace.navigation")
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(@repository.route_id)
json.branchSubmissionMode(@repository.local? ? "disabled" : "copilot")
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(@repository.route_id)
json.partial! partial: "shared/analytics_navigation"
json.selectedRepositoryId @repository.route_id.to_s

json.repositories do
  json.array! @repositories do |repository|
    json.id repository.route_id.to_s
    json.nameWithOwner repository.name_with_owner
    json.path repository_path(repository.route_id)
  end
end

json.repositoryId @repository.route_id
json.repositoryName @repository.name_with_owner
json.repositoryPath repository_path(@repository.route_id)
json.prototypeId @prototype.id
json.controlsIdentity preview_controls_identity(@prototype, context: [ "authenticated", Current.user.id ])
json.branchName @prototype.branch_name
json.branchPath repository_prototype_path(@repository.route_id, @prototype)
json.buildPinned params.key?(:build)
json.prototypeName @prototype.name.presence || @prototype.branch_name
json.prototypeDescription @prototype.description
json.showPrototypeInfo @show_prototype_info
json.historyLabel t("prototypes.show.history")
json.historyPath repository_prototype_builds_path \
  @repository.route_id,
  @prototype,
  **(params.key?(:build) ? { build: @selected_build.number } : {})
json.moreActionsLabel t("prototypes.show.more_actions")
json.openInNewTabLabel t("prototypes.show.open_in_new_tab")
json.minimizeHubLabel t("prototypes.show.minimize_hub")
json.maximizeHubLabel t("prototypes.show.maximize_hub")
json.dragControlsLabel t("prototypes.show.drag_controls")
json.minimizedPreview params[:view] == "minimized"
json.previewUrlLabel t("prototypes.show.prototype_link")
json.copyPreviewUrlLabel t("prototypes.show.copy_prototype_link")
json.copiedPreviewUrlLabel t("prototypes.show.copied_prototype_link")
json.copyPreviewUrlErrorLabel t("prototypes.show.copy_prototype_link_error")
json.closeLabel t("prototypes.show.close")
json.useDarkThemeLabel t("prototypes.show.use_dark_theme")
json.useLightThemeLabel t("prototypes.show.use_light_theme")
json.descriptionLabel t("prototypes.show.description")
json.noDescriptionLabel t("prototypes.show.no_description")
json.alert flash[:alert]
if @can_edit_details
  json.detailsEditPath repository_prototype_registration_path(@repository.route_id, @prototype)
  json.editDetailsLabel t("prototypes.show.edit_details")
  json.editDetailsHeading t("prototype_management.show.edit_dialog_heading")
  json.nameLabel t("prototype_management.show.name_label")
  json.startPage @prototype.start_page
  json.startPageLabel t("prototype_management.show.start_page_label")
  json.startPageHint t("prototype_management.show.start_page_hint")
  json.saveDetailsLabel t("prototype_management.show.save_label")
  json.cancelEditLabel t("prototype_management.show.cancel_label")
  json.nameMaximumLength 255
  json.descriptionMaximumLength Prototype::DESCRIPTION_MAXIMUM_LENGTH
end
json.prototypeInfoLabel t("prototypes.show.prototype_info")
json.dismissInfoLabel t("prototypes.show.dismiss_info")
json.closeInfoLabel t("prototypes.show.close_info")
json.branchFromHereLabel t("prototypes.show.branch_from_here")
json.forkLabel t("prototypes.show.fork")
json.branchFromLabel t("prototypes.show.branch_from", name: @prototype.name.presence || @prototype.branch_name)
json.branchPlaceholder t("prototypes.show.branch_placeholder")
json.branchSubmitLabel t("prototypes.show.branch_submit")
json.branchInstructions t("prototypes.show.branch_instructions", branch: @prototype.branch_name)
json.branchPageInstructions t("prototype_prompts.viewed_page", route: "%{route}")

json.branchContinuation do
  json.continuationHeading t("new_prototypes.show.continuation_heading")
  json.continueMessage t("new_prototypes.show.continue_message")
  json.installMessage t("new_prototypes.show.install_message")
  json.downloadLabel t("new_prototypes.show.download_label")
  json.downloadUrl t("new_prototypes.show.download_url")
  json.openAppLabel t("new_prototypes.show.open_app_label")
  json.closeLabel t("new_prototypes.show.close_label")
  json.copyPromptLabel t("new_prototypes.show.copy_prompt_label")
  json.copiedLabel t("new_prototypes.show.copied_label")
  json.copyErrorLabel t("new_prototypes.show.copy_error_label")
end

author_build = @selected_build || @latest_build

json.author do
  json.avatarUrl(@repository.local? ? User::LOCAL_AVATAR_URL : author_build&.commit_author_avatar_url)

  if @repository.local?
    json.label t("prototypes.show.author", login: Current.user.login)
    json.url nil
  elsif author_build&.commit_author_login
    json.label t("prototypes.show.author", login: author_build.commit_author_login)
    json.url author_build.commit_author.profile_url
  elsif author_build&.commit_author_name
    json.label t("prototypes.show.author_name", name: author_build.commit_author_name)
    json.url nil
  else
    json.label t("repositories.show.unknown_author")
    json.url nil
  end
end

if @can_manage_share_links && @selected_build
  json.shareLinksLabel t("prototypes.show.share_links")
  json.shareLinksPath repository_prototype_share_links_path \
    @repository.route_id,
    @prototype,
    **(params.key?(:build) ? { build: @selected_build.number } : {})
end

json.reviewCommentsPath repository_prototype_review_comments_path(@repository.route_id, @prototype)

json.reviewComments do
  json.bodyMaximumBytes ReviewComment::BODY_MAXIMUM_BYTES

  json.copy do
    json.heading t("prototypes.show.review_comments.heading")
    json.closeLabel t("prototypes.show.review_comments.close")
    json.commentMenuLabel t("prototypes.show.review_comments.comment_menu")
