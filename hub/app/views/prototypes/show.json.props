      author: "%{author}",
      count: "%{count}"
    json.replyCountOneLabel t("prototypes.show.review_comments.reply_one")
    json.replyCountOtherLabel t("prototypes.show.review_comments.reply_other", count: "%{count}")
    json.threadHeading t("prototypes.show.review_comments.thread_heading")
    json.backToCommentsLabel t("prototypes.show.review_comments.back_to_comments")
