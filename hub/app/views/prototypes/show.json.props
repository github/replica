json.emptyHeading t("prototypes.show.empty_heading")
json.emptyLabel t("prototypes.show.empty")

if @latest_build
  json.latestBuild do
    json.number @latest_build.number
    json.state @latest_build.state
    json.stateLabel t("build_states.#{@latest_build.state}")
  end
end

if @selected_build
  json.selectedBuild do
    json.number @selected_build.number
    json.previewUrl "#{PreviewOrigin.current.url(@selected_build.id)}#{@preview_path.delete_prefix('/')}"
    json.detailsLabel t("prototypes.show.details")
    json.detailsPath repository_prototype_build_path \
      @repository.route_id,
      @prototype,
      @selected_build.number
    json.frameTitle t("prototypes.show.frame_title", branch: @prototype.branch_name, number: @selected_build.number)
  end
end

json.buildOptions do
  json.array! @build_options do |build|
    json.number build.number
    json.label t("prototypes.show.build_option", number: build.number)
    json.state build.state
    json.stateLabel t("prototypes.show.build_status.#{build.state}") unless build.state == "successful"

    if build.state == "successful"
      json.path repository_prototype_path(@repository.route_id, @prototype, build: build.number)
    else
      json.path repository_prototype_build_path(@repository.route_id, @prototype, build.number)
    end
  end
end

json.buildSelectionLabel t("prototypes.show.build_selection")

if @latest_build&.state == "failed" && @selected_build && @latest_build != @selected_build
  json.newerBuildLabel t("prototypes.show.newer_build")
end
