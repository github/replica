json.auditLabel t("hub_admins.audit")
json.auditPath(@access_denied ? nil : security_audit_path)
json.hubAdminsLabel t("hub_admins.heading")
json.hubAdminsPath(@access_denied ? nil : hub_admins_path)
json.sharingSettingsLabel t("sharing_settings.heading")
json.sharingSettingsPath(@access_denied ? nil : sharing_settings_path)
json.sessionRevocationLabel t("session_revocation.heading")
json.sessionRevocationPath(@access_denied ? nil : session_revocation_path)
json.githubAppLabel t("github_app.heading")
json.githubAppPath(@access_denied ? nil : github_app_path)
json.copilotConnectionLabel t("copilot_connection.heading")
json.copilotConnectionPath(@access_denied ? nil : copilot_connection_path)
json.repositoriesLabel t("hub_admins.repositories")
json.repositoriesPath repositories_path
json.signOutLabel t("authenticated.sign_out")
json.signOutPath session_path
json.authenticityToken form_authenticity_token
json.notice flash[:notice]
json.alert flash[:alert]
section = case controller_path
when "sharing_settings" then "sharing"
when "github_apps", "github_app_credentials", "github_app_webhook_rotations" then "github"
when "copilot_connections" then "copilot"
else "admins"
end
json.partial! partial: "shared/hub_administration_workspace", locals: { selected_section: section }
