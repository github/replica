json.productName t("application.name")
json.pageTitle t(@continuing ? "fresh_authorization.continuing_heading" : "fresh_authorization.heading")
json.heading t(@continuing ? "fresh_authorization.continuing_heading" : "fresh_authorization.heading")
json.description t(@continuing ? "fresh_authorization.continuing_description" : "fresh_authorization.description")
json.submitLabel t(@continuing ? "fresh_authorization.continue" : "fresh_authorization.submit")
json.cancelLabel t("fresh_authorization.cancel")
json.submitPath(@continuing ? @challenge.pending_action.fetch("path") : fresh_authorization_path(@challenge.public_id))
json.cancelPath fresh_authorization_path(@challenge.public_id)
json.authenticityToken form_authenticity_token
if @continuing
  json.continuation do
    json.id @challenge.public_id
    json.set! :method, @challenge.pending_action.fetch("method")
  end
end
if FreshAuthorization::ADMIN_PURPOSES.include?(@challenge.purpose)
  section = case @challenge.purpose
  when "hub_admin_management" then "admins"
  when "sharing_settings" then "sharing"
  when "session_revocation" then "sessions"
  else "github"
  end
  json.partial! partial: "shared/hub_administration_workspace", locals: { selected_section: section }
end
