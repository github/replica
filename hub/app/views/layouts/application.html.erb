<!DOCTYPE html>
<html data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <title><%= content_for(:title) || @document_title || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= vite_client_tag nonce: content_security_policy_nonce %>
    <%= vite_react_refresh_tag nonce: content_security_policy_nonce %>
    <%= vite_typescript_tag "application.tsx", nonce: content_security_policy_nonce %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
