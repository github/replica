json.pageTitle @repository.name_with_owner
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.partial! partial: "shared/hub_administration_navigation"
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.repositorySelectorLabel t \
  "repository_workspace.repository_selector",
  repository: @repository.name_with_owner
json.repositoryMenuLabel t("repository_workspace.repositories")
json.navigationLabel t("repository_workspace.navigation")
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(@repository.route_id)
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(@repository.route_id)
json.partial! partial: "shared/analytics_navigation"
json.selectedRepositoryId @repository.route_id.to_s

json.repositories do
  json.array! @repositories do |repository|
    json.id repository.route_id.to_s
    json.nameWithOwner repository.name_with_owner
    json.path repository_path(repository.route_id)
  end
end

json.prototypesHeading t("repositories.show.prototypes_heading")
json.alert flash[:alert]
json.notice flash[:notice]
json.prototypesCountLabel t("repositories.show.prototype_count", count: @listing.matching_count)
json.searchLabel t("repositories.show.search")
json.clearSearchLabel t("repositories.show.clear_search")
json.noSearchResultsHeading t("repositories.show.no_search_results_heading")
json.noSearchResultsDescription t("repositories.show.no_search_results_description")
json.viewLabel t("repositories.show.view")
json.galleryViewLabel t("repositories.show.gallery_view")
json.listViewLabel t("repositories.show.list_view")
json.prototypeColumnLabel t("repositories.show.prototype_column")
json.ownerColumnLabel t("repositories.show.owner_column")
json.buildColumnLabel t("repositories.show.build_column")
json.passingLabel t("repositories.show.passing")
json.notPassingLabel t("repositories.show.not_passing")
json.noBuildLabel t("repositories.show.no_build")
json.emptyHeading t("repositories.show.empty_heading")
json.emptyLabel t(@repository.local? ? "repositories.show.local_empty" : "repositories.show.empty")
json.buildPrototypeLabel t("repositories.show.build_prototype")

listing_params = { q: @listing.query.presence, author: @listing.author.presence }.compact
json.listing do
  json.query @listing.query
  json.author @listing.author
  author_label = if @listing.author == "me"
    t("repositories.show.filters.me")
  elsif @listing.author_user
    "@#{@listing.author_user.login}"
  elsif @listing.author.present?
    t("repositories.show.unknown_author")
  else
    t("repositories.show.filters.all_authors")
  end
  json.authorLabel author_label
  json.matchingCount @listing.matching_count
  json.page @listing.page
  json.pageCount @listing.page_count
  json.pagePath repository_path(@repository.route_id, **listing_params)
  json.authorsPath repository_prototype_authors_path(@repository.route_id)
  json.path repository_path(@repository.route_id)
  json.copy do
    %w[author me all_authors search_authors more_authors first_authors no_authors loading retry
      authors_failed results_failed previous next pagination updating shown].each do |key|
      json.set! key.camelize(:lower), t("repositories.show.filters.#{key}", count: @prototypes.length)
    end
  end
end

if @repository_writable
  json.managePrototypesPath repository_prototype_management_path(@repository.route_id)
  json.managePrototypesLabel t("repositories.show.manage_prototypes")
  json.recentBranches do
    json.array! @recent_branches || [] do |prototype|
      json.id prototype.id.to_s
      json.branchName prototype.branch_name
      json.title t \
        @repository.local? ? "repositories.show.recent_local_branch" : "repositories.show.recent_branch",
        branch: prototype.branch_name
      json.registrationPath repository_prototype_registration_path(@repository.route_id, prototype)
      json.dismissalPath repository_prototype_branch_banner_dismissal_path(@repository.route_id, prototype)
    end
  end
  json.addToHubLabel t("prototype_management.show.add_label")
  json.declineBranchLabel t("repositories.show.decline_branch")
  json.candidateCheckFailed t("repositories.show.candidate_check_failed") if @candidate_check_failed
end

if !@repository.local? && ![ :current, :present ].include?(@workflow_status)
  json.workflowInstallation do
    if @workflow_status == :different && Rails.configuration.x.build_action.present?
      json.heading t("repositories.show.workflow.different_heading")
    elsif @workflow_status == :missing && Rails.configuration.x.build_action.present?
      json.heading t("repositories.show.workflow.missing_heading")
    else
      json.heading t("repositories.show.workflow.heading")
    end

    if @workflow_status == :unavailable
      json.state "unavailable"
      json.description t("repositories.show.workflow.check_failed")
    elsif Rails.configuration.x.build_action.blank?
      json.state "unavailable"
      json.description t("repositories.show.workflow.unconfigured")
    elsif @repository_writable && @workflow_status == :different
      json.state "updatable"
      json.description t("repositories.show.workflow.different")
      json.actionLabel t("repositories.show.workflow.update")
      json.createPath repository_workflow_installation_path(@repository.route_id)
    elsif @repository_writable
      json.state "installable"
      json.description t("repositories.show.workflow.missing")
      json.actionLabel t("repositories.show.workflow.install")
      json.createPath repository_workflow_installation_path(@repository.route_id)
    else
      json.state "requiresWriter"

      if @workflow_status == :different
        json.description t("repositories.show.workflow.update_requires_writer")
      else
        json.description t("repositories.show.workflow.install_requires_writer")
        json.documentationLabel t("repositories.show.workflow.learn_more")
        json.documentationUrl "https://github.com/github/replica#prototype-build-workflow"
      end
    end
  end
end

json.prototypes do
  json.array! @prototypes do |prototype|
    latest_build = @latest_builds[prototype.id]
    review_build = @review_builds[prototype.id]

    json.id prototype.id.to_s
    json.branchName prototype.branch_name
    json.name prototype.name
    json.description prototype.description
    json.path repository_prototype_path(@repository.route_id, prototype)

    if @repository.local?
      json.author do
        json.avatarUrl User::LOCAL_AVATAR_URL
        json.label t("repositories.show.card_author", login: Current.user.login)
        json.ownerLabel "@#{Current.user.login}"
        json.url nil
      end
    elsif prototype.author
      json.author do
        json.avatarUrl prototype.author.avatar_url
        json.label t("repositories.show.card_author", login: prototype.author.login)
        json.ownerLabel "@#{prototype.author.login}"
        json.url "#{Rails.configuration.x.github_url}/#{CGI.escapeURIComponent(prototype.author.login)}"
      end
    else
      json.author do
        json.avatarUrl nil

        json.label t("repositories.show.unknown_author")
        json.ownerLabel t("repositories.show.unknown_author")

        json.url nil
      end
    end

    if latest_build
      json.latestBuild do
        json.state latest_build.state
        json.stateLabel t("build_states.#{latest_build.state}")
      end
    end

    if review_build
      json.reviewBuild do
        json.number review_build.number
        json.screenshotAlt t \
          "repositories.show.screenshot_alt",
          branch: prototype.branch_name,
          number: review_build.number
        json.screenshotSrc repository_prototype_build_screenshot_path \
          @repository.route_id,
          prototype,
          review_build.number,
          "desktop"
        json.darkScreenshotSrc repository_prototype_build_screenshot_path \
          @repository.route_id,
          prototype,
          review_build.number,
          "desktop",
          theme: "dark"
      end
    else
      json.previewFallbackLabel t("repositories.show.preview_fallback")
    end
  end
end
