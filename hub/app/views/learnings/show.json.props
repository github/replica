json.pageTitle t("learnings.heading")
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.partial! partial: "shared/hub_administration_navigation"
json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
json.expandNavigationLabel t("repository_workspace.expand_navigation")
json.systemThemeLabel t("repository_workspace.theme_system")
json.lightThemeLabel t("repository_workspace.theme_light")
json.darkThemeLabel t("repository_workspace.theme_dark")
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.repositorySelectorLabel t("repository_workspace.repository_selector", repository: @repository.name_with_owner)
json.repositoryMenuLabel t("repository_workspace.repositories")
json.navigationLabel t("repository_workspace.navigation")
json.newPrototypeLabel t("repository_workspace.new_prototype")
json.newPrototypePath repository_new_prototype_path(@repository.route_id)
json.prototypesLabel t("repository_workspace.prototypes")
json.prototypesPath repository_path(@repository.route_id)
json.partial! partial: "shared/analytics_navigation"
json.selectedSection "learnings"
json.selectedRepositoryId @repository.route_id.to_s

json.repositories do
  json.array! @repositories do |repository|
    json.id repository.route_id.to_s
    json.nameWithOwner repository.name_with_owner
    json.path repository_path(repository.route_id)
  end
end

json.alert flash[:alert]
json.notice flash[:notice]

credits = ->(nano) {
  number_with_precision(nano.to_d / 1_000_000_000, precision: 3, significant: true, strip_insignificant_zeros: true)
}
active_run = @runs.find(&:active?)

json.copy do
  json.heading t("learnings.heading")
  json.description t("learnings.description")
  json.runLabel t("learnings.run.label")
  json.suggestionsHeading t("learnings.suggestions.heading")
  json.suggestionsEmpty t(@repository.local? ? "learnings.suggestions.empty_local" : "learnings.suggestions.empty")
  json.evidenceHeading t("learnings.suggestions.evidence")
  json.contradictionsHeading t("learnings.suggestions.contradictions")
  json.replacementHeading t("learnings.suggestions.replaces")
  json.deletedComment t("learnings.suggestions.deleted")
  json.accept t("learnings.suggestions.accept")
  json.edit t("learnings.suggestions.edit")
  json.contentLabel t("learnings.suggestions.content_label")
  json.acceptEdited t("learnings.suggestions.accept_edited")
  json.reject t("learnings.suggestions.reject")
  json.rejectReason t("learnings.suggestions.reject_reason")
  json.confirmReject t("learnings.suggestions.confirm_reject")
  json.cancel t("learnings.suggestions.cancel")
  json.acceptedHeading t("learnings.accepted.heading")
  json.acceptedEmpty t("learnings.accepted.empty")
  json.retire t("learnings.accepted.retire")
  json.retireReason t("learnings.accepted.retire_reason")
  json.confirmRetire t("learnings.accepted.confirm_retire")
  json.recallHeading t("learnings.recall.heading")
  json.recallDescription t("learnings.recall.description")
  json.recallEmpty t("learnings.recall.empty")
  json.runsHeading t("learnings.runs.heading")
  json.runsEmpty t("learnings.runs.empty")
  json.runColumns do
    %w[started started_by result usage].each { json.set! _1.camelize(:lower), t("learnings.runs.columns.#{_1}") }
  end
end

json.status do
  json.message(
    if LocalDevelopment.enabled?
      t("learnings.status.local")
    elsif CopilotConnection.credential.nil?
      copilot_billing_t("status.no_token", scope: "learnings")
    elsif @connection&.refused?
      copilot_billing_t("status.refused", scope: "learnings", date: @connection.refused_at.to_date.to_fs(:long))
    elsif @connection && !@connection.confirmed?
      t("learnings.organization.status.unconfirmed")
    else
      t("learnings.status.scheduled", login: @connection&.user&.login)
    end
  )
  json.refused(!LocalDevelopment.enabled? && !@connection&.usable?)
  json.activity(active_run && t("learnings.status.#{active_run.state}"))
  json.usage t("learnings.status.usage",
    credits: credits.(Learning::Run.where(repository: @repository).usage_since(30.days.ago)))
end

json.run do
  json.path repository_learnings_runs_path(@repository.route_id)
  # Asking for a daily run that still waits moves it ahead, so only a run already asked for or
  # running hides the action.
  waiting_daily = active_run&.scheduled && active_run.state == "queued"
  json.available((active_run.nil? || waiting_daily) && (LocalDevelopment.enabled? || @connection&.usable?))
end

json.loadError(@load_error && t("learnings.load_error", reason: @load_error))
json.identityNotice(@overview[:identityReviewCount].positive? ? t("learnings.identity_notice") : nil)

json.suggestions do
  json.array! @overview[:suggestions] do |suggestion|
    json.id suggestion[:id]
    json.content suggestion[:content]
    json.digest suggestion[:reviewDigest]
    json.decisionPath decision_repository_learnings_path(@repository.route_id, suggestion[:id])
    json.support(
      if suggestion[:reviewers] && suggestion[:prototypes]
        t \
          "learnings.suggestions.support",
          reviewers: t("learnings.suggestions.reviewers", count: suggestion[:reviewers]),
          prototypes: t("learnings.suggestions.prototypes", count: suggestion[:prototypes])
      end
    )
    json.replaces do
      json.array! suggestion[:replaces] do |target|
        json.id target[:id]
        json.content target[:content] || t("learnings.suggestions.replacement_unavailable")
      end
    end
    json.evidence suggestion[:evidence]
    json.otherEvidence(suggestion[:otherEvidence].positive? ?
      t("learnings.suggestions.other_evidence", count: suggestion[:otherEvidence]) : nil)
    json.contradictions suggestion[:contradictions]
    json.otherContradictions(suggestion[:otherContradictions].positive? ?
      t("learnings.suggestions.other_contradictions", count: suggestion[:otherContradictions]) : nil)
  end
end

json.learnings do
  json.array! @overview[:learnings] do |learning|
    json.id learning[:id]
    content_key = if learning[:damaged]
      "learnings.accepted.damaged_content"
    elsif learning[:identityNeedsReview]
      "learnings.accepted.identity_content"
    else
      "learnings.accepted.withheld"
    end
    json.content learning[:content] || t(content_key)
    json.decisionPath decision_repository_learnings_path(@repository.route_id, learning[:id])
    json.accepted(
      if learning[:acceptedBy] && learning[:acceptedAt]
        t \
          learning[:edited] ? "learnings.accepted.accepted_by_edited" : "learnings.accepted.accepted_by",
          login: learning[:acceptedBy],
          date: Time.iso8601(learning[:acceptedAt]).to_date.to_fs(:long)
      end
    )
    json.recalled learning[:recalled]
    json.status(
      if learning[:damaged]
        t("learnings.accepted.damaged")
      elsif learning[:identityNeedsReview]
        t("learnings.accepted.identity_review")
      elsif learning[:budgetExcluded]
        t("learnings.accepted.budget_excluded")
      else
        t(learning[:recalled] ? "learnings.accepted.recalled" : "learnings.accepted.not_recalled")
      end
    )
  end
end

json.recall do
  json.text @overview.dig(:recall, :text)
  json.count @overview.dig(:recall, :count)
end

json.runs do
  json.array! @runs do |run|
    json.id run.id
    json.startedAt (run.started_at || run.created_at).utc.iso8601
    json.startedBy(
      if run.scheduled
        t("learnings.runs.daily")
      elsif run.requested_by
        t("learnings.runs.requested_by", login: run.requested_by.login)
      else
        t("learnings.runs.requested_by_someone")
      end
    )
    json.state run.state
    json.stateLabel t("learnings.runs.states.#{run.state}")
    json.result(
      case run.state
      when "failed" then run.failure_summary
      when "succeeded"
        parts = [ t("learnings.runs.comments", count: run.comments_considered) ]
        parts << t("learnings.runs.labeled", count: run.comments_labeled) if run.comments_considered.positive?
        parts << t("learnings.runs.suggestions", count: run.suggestions)
        parts << t("learnings.runs.remaining", count: run.comments_remaining) if run.comments_remaining.positive?
        if run.suggestions_remaining.positive?
          parts << t("learnings.runs.suggestions_remaining", count: run.suggestions_remaining)
        end
        parts.join(", ")
      end
    )
    json.usage(
      if run.copilot_requests.positive?
        t("learnings.runs.usage", credits: credits.(run.nano_aiu),
          requests: t("learnings.runs.requests", count: run.copilot_requests))
      else
        t("learnings.runs.no_usage")
      end
    )
  end
end
