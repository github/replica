unless request.format.json? && params[:props_at].present?
  json.sectionLoadId SecureRandom.uuid
  json.pageTitle t("repository_workspace.prototypes")
  json.signOutLabel t("authenticated.sign_out")
  json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
  json.partial! partial: "shared/hub_administration_navigation"
  json.collapseNavigationLabel t("repository_workspace.collapse_navigation")
  json.expandNavigationLabel t("repository_workspace.expand_navigation")
  json.systemThemeLabel t("repository_workspace.theme_system")
  json.lightThemeLabel t("repository_workspace.theme_light")
  json.darkThemeLabel t("repository_workspace.theme_dark")
  json.signOutPath session_path
  json.authenticityToken form_authenticity_token

  json.currentUser do
    json.login Current.user.login
    json.name Current.user.name
    json.avatarUrl Current.user.avatar_url
  end

  json.repositorySelectorLabel t \
    "repository_workspace.repository_selector",
    repository: @repository.name_with_owner
  json.repositoryMenuLabel t("repository_workspace.repositories")
  json.navigationLabel t("repository_workspace.navigation")
  json.newPrototypeLabel t("repository_workspace.new_prototype")
  json.newPrototypePath repository_new_prototype_path(@repository.route_id)
  json.prototypesLabel t("repository_workspace.prototypes")
  json.prototypesPath repository_path(@repository.route_id)
  json.partial! partial: "shared/analytics_navigation"
  json.selectedRepositoryId @repository.route_id.to_s

  json.repositories do
    json.array! @repositories do |repository|
      json.id repository.route_id.to_s
      json.nameWithOwner repository.name_with_owner
      json.path repository_path(repository.route_id)
    end
  end

  json.alert flash[:alert]
  json.backLabel t("prototype_management.show.back_label")
end

json.repositoryChoices do
  json.path repository_prototype_management_path(@repository.route_id, props_at: "data.repositoryChoices")
  json.loadingLabel t("repository_workspace.loading_repositories")
  json.errorLabel t("repository_workspace.repositories_unavailable")
  json.retryLabel t("repository_workspace.retry")
  json.failed !!@repository_navigation_unavailable
  json.repositories do
    json.array! @repositories do |repository|
      json.id repository.route_id.to_s
      json.nameWithOwner repository.name_with_owner
      json.path repository_path(repository.route_id)
    end
  end
end

json.management do
  %w[
    heading unlisted_heading unlisted_description registered_heading registered_empty_label empty_label
    name_label description_label start_page_label start_page_hint add_label edit_label save_label cancel_label add_dialog_heading
    edit_dialog_heading close_dialog_label
  ].each do |key|
    json.set! key.camelize(:lower), t("prototype_management.show.#{key}")
  end

  json.nameMaximumLength 255
  json.descriptionMaximumLength Prototype::DESCRIPTION_MAXIMUM_LENGTH
  json.candidateCheckFailed !!@candidate_check_failed
  json.candidateCheckFailedLabel t("repositories.show.candidate_check_failed")
  json.candidateLoadingLabel t("prototype_management.show.loading_branches")
  json.candidateRetryLabel t("prototype_management.show.retry")
  json.candidateDataPath repository_prototype_management_path \
    @repository.route_id,
    page: @candidate_page,
    props_at: "data.management"
  json.candidatePage @candidate_page
  json.candidatePageCount @candidate_page_count
  json.candidatePagePath @candidate_page_path
  json.paginationLabel t("prototype_management.show.pagination_label")
  json.previousPageLabel t("prototype_management.show.previous_page_label")
  json.previousPageAriaLabel t("prototype_management.show.previous_page_aria_label")
  json.nextPageLabel t("prototype_management.show.next_page_label")
  json.nextPageAriaLabel t("prototype_management.show.next_page_aria_label")

  json.unlisted do
    json.array! @unregistered_prototypes do |prototype|
      json.id prototype.id.to_s
      json.branchName prototype.branch_name
      json.name prototype.branch_name
      json.description nil
      json.startPage prototype.start_page
      json.startPageImportError prototype.start_page_import_error
      json.path repository_prototype_registration_path(@repository.route_id, prototype)
    end
  end

  json.registered do
    json.array! @registered_prototypes do |prototype|
      json.id prototype.id.to_s
      json.branchName prototype.branch_name
      json.name prototype.name
      json.description prototype.description
      json.startPage prototype.start_page
      json.startPageImportError prototype.start_page_import_error
      json.path repository_prototype_registration_path(@repository.route_id, prototype)
    end
  end
end
