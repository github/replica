# Reread the saved role so a cached account cannot keep a revoked entrypoint.
hub_admin = Current.user &&
  User.where(id: Current.user.id, hub_admin: true).where.not(github_id: nil).exists? &&
  local_assigns.fetch(:administration_allowed, true)
json.settingsNavigationLabel t("hub_administration_workspace.settings_navigation")
json.feedbackLabel t("repository_workspace.feedback")
context_repository = local_assigns.fetch(:context_repository, @repository)
context = { repository_github_id: context_repository&.route_id }
json.administrationLinks(hub_admin ? [
  { section: "github", label: t("github_app.heading"), path: github_app_path(**context) },
  { section: "copilot", label: t("copilot_connection.heading"), path: copilot_connection_path(**context) },
  { section: "admins", label: t("hub_admins.heading"), path: hub_admins_path(**context) },
  { section: "sharing", label: t("sharing_settings.heading"), path: sharing_settings_path(**context) },
  { section: "sessions", label: t("session_revocation.heading"), path: session_revocation_path(**context) }
] : [])
