json.pageTitle t("share_links.index.page_title", branch: @prototype.branch_name)
json.partial! partial: "shared/review_workspace"
json.productName t("application.name")
json.rootPath root_path
json.repositoriesLabel t("repository_workspace.repositories")
json.repositoriesPath repository_path(@repository.route_id)
json.repositoryName @repository.name_with_owner
json.repositoryPath repository_path(@repository.route_id)
json.branchName @prototype.branch_name
json.branchPath repository_prototype_path(@repository.route_id, @prototype)
json.heading t("share_links.index.heading")
json.description t("share_links.index.description")
json.publicSharingEnabled @public_sharing_enabled
json.disabledLabel t("share_links.disabled")
json.alert flash[:alert]
json.notice flash[:notice]
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.signedInAsLabel t("authenticated.signed_in_as", login: Current.user.login)
json.signOutPath session_path
json.authenticityToken form_authenticity_token
json.controlSettingsIdentity "#{@repository.route_id}:#{@prototype.id}"
json.managementBuildNumber @selected_build.number if params.key?(:build) && @selected_build
json.controlSettingsCopy do
  json.label t("share_links.index.controls.label")
  json.description t("share_links.index.controls.description")
end

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.form do
  json.createPath repository_prototype_share_links_path(@repository.route_id, @prototype)
  json.labelLabel t("share_links.index.form.label")
  json.labelPlaceholder t("share_links.index.form.label_placeholder")
  json.labelMaximumBytes ShareLink::LABEL_MAXIMUM_BYTES
  json.expirationLabel t("share_links.index.form.expiration")
  json.submitLabel t("share_links.index.form.submit")
  json.buildLabel @selected_build ? t("share_links.index.build", number: @selected_build.number) : nil

  json.expirationOptions do
    json.array! ShareLink.expiration_options.keys do |value|
      json.value value
      json.label t("share_links.expirations.#{value}")
    end
  end
end

json.emptyHeading t("share_links.index.empty_heading")
json.emptyLabel t("share_links.index.empty")
json.noBuildHeading t("share_links.index.no_build_heading")
json.noBuildLabel t("share_links.index.no_build")
json.copyLabel t("share_links.index.copy")
json.copiedLabel t("share_links.index.copied")
json.copyErrorLabel t("share_links.index.copy_error")
json.openLabel t("share_links.index.open")
json.deleteLabel t("share_links.index.delete")

json.shareLinks do
  json.array! @share_links do |share_link|
    json.id share_link.id
    json.label share_link.label
    json.url "#{Rails.configuration.x.hub_origin.delete_suffix("/")}#{shared_build_path(share_link.public_id)}"
    json.buildLabel t("share_links.index.build", number: share_link.build.number)
    json.createdAt share_link.created_at.iso8601
    json.createdLabel t \
      "share_links.index.created",
      author: "@#{share_link.created_by.login}",
      time: l(share_link.created_at, format: :long)
    expiration = share_link.effective_expires_at
    json.expiresAt expiration&.iso8601

    if expiration
      json.expiresLabel t \
        "share_links.index.expires",
        time: l(expiration, format: :long)
    else
      json.expiresLabel t("share_links.index.never_expires")
    end

    json.deletePath repository_prototype_share_link_path \
      @repository.route_id,
      @prototype,
      share_link
    json.deletePrompt t("share_links.index.delete_prompt", label: share_link.label)
  end
end
