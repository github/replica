json.partial! partial: "github_apps/configuration"
json.pageTitle t("github_app.heading")
json.heading t("github_app.heading")
json.description t("github_app.description")
paragraphs = if @configuration
  [ t("github_app.webhook.#{@configuration.webhook_rotation_state}") ]
else
  [ t("github_app.not_configured") ]
end
if @configuration&.installation_state.in?(%w[not_installed removed])
  paragraphs << t("github_app.installation_required", owner: @configuration.owner_login)
end
json.paragraphs paragraphs
json.links \
  @configuration ? [
  { label: t("github_app.credentials.heading"), path: edit_github_app_credentials_path },
  { label: t("github_app.webhook.heading"), path: github_app_webhook_rotation_path },
  { label: t("github_app.reset.heading"), path: reset_github_app_path }
  ] : []
json.form nil
