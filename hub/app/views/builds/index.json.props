json.pageTitle t("builds.index.page_title", branch: @prototype.branch_name)
json.partial! partial: "shared/review_workspace"
json.productName t("application.name")
json.rootPath root_path
json.repositoriesLabel t("repository_workspace.repositories")
json.repositoriesPath repository_path(@repository.route_id)
json.repositoryName @repository.name_with_owner
json.repositoryPath repository_path(@repository.route_id)
json.branchName @prototype.branch_name
json.branchPath repository_prototype_path(@repository.route_id, @prototype)
json.buildsHeading t("builds.index.heading")
json.emptyLabel t("builds.index.empty")
json.newestPageLabel t("builds.index.newest_page")
json.newestPagePath @newest_page_path
json.nextPageLabel t("builds.index.next_page")
json.nextPagePath @next_page_path
json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.signedInAsLabel t("authenticated.signed_in_as", login: Current.user.login)
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end

json.builds do
  json.array! @builds do |build|
    json.number build.number
    json.numberLabel t("builds.index.build_number", number: build.number)
    json.commitSha build.commit_sha
    json.shortCommitSha build.commit_sha.first(7)
    json.commitLabel t("builds.index.commit", sha: build.commit_sha.first(7))
    json.state build.state
    json.stateLabel t("build_states.#{build.state}")
    json.createdAt build.chronological_at.iso8601
    timestamp_label = build.workflow_created_at ? "workflow_created" : "created"
    json.createdLabel t("builds.index.#{timestamp_label}", time: l(build.chronological_at, format: :long))
    json.path repository_prototype_build_path(@repository.route_id, @prototype, build.number)

    json.author do
      json.avatarUrl(@repository.local? ? User::LOCAL_AVATAR_URL : build.commit_author_avatar_url)

      if @repository.local?
        json.label t("repositories.show.author", login: Current.user.login)
      elsif build.commit_author_login
        json.label t("repositories.show.author", login: build.commit_author_login)
      elsif build.commit_author_name
        json.label t("repositories.show.author_name", name: build.commit_author_name)
      else
        json.label t("repositories.show.unknown_author")
      end

      json.url(@repository.local? ? nil : build.commit_author.profile_url)
    end
  end
end
