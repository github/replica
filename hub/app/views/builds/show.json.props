json.pageTitle t("builds.show.page_title", number: @build.number, branch: @prototype.branch_name)
json.partial! partial: "shared/review_workspace"
json.productName t("application.name")
json.rootPath root_path
json.repositoriesLabel t("repository_workspace.repositories")
json.repositoriesPath repository_path(@repository.route_id)
json.repositoryName @repository.name_with_owner
json.repositoryPath repository_path(@repository.route_id)
json.branchName @prototype.branch_name
json.branchPath repository_prototype_path(@repository.route_id, @prototype)
json.heading t("builds.show.heading", number: @build.number)
json.state @build.state
json.stateLabel t("build_states.#{@build.state}")
json.commitHeading t("builds.show.commit_heading")
json.commitSha @build.commit_sha

json.commitAuthor do
  json.avatarUrl(@repository.local? ? User::LOCAL_AVATAR_URL : @build.commit_author_avatar_url)

  if @repository.local?
    json.label t("repositories.show.author", login: Current.user.login)
  elsif @build.commit_author_login
    json.label t("repositories.show.author", login: @build.commit_author_login)
  elsif @build.commit_author_name
    json.label t("repositories.show.author_name", name: @build.commit_author_name)
  else
    json.label t("repositories.show.unknown_author")
  end

  json.url(@repository.local? ? nil : @build.commit_author.profile_url)
end

if Build::WorkflowRun.github_url?(@build.workflow_url)
  json.workflowHeading t("builds.show.workflow_heading")
  json.workflowLabel t("builds.show.workflow_link")
  json.workflowUrl @build.workflow_url
end

if @build.failure_summary
  json.failureHeading t("builds.show.failure_heading")
  json.failureSummary @build.failure_summary
end

if @build.artifact_bytes
  json.publicationHeading t("builds.show.publication_heading")
  json.retainedSizeLabel t \
    "builds.show.retained_size",
    size: number_to_human_size(@build.artifact_bytes, precision: 3)
  json.previewLabel t("builds.show.preview_link")
  json.previewPath repository_prototype_path \
    @repository.route_id,
    @prototype,
    build: @build.number
  json.screenshotsHeading t("builds.show.screenshots_heading")

  json.desktopScreenshot do
    json.alt t("builds.show.desktop_screenshot_alt", number: @build.number)
    json.label t("builds.show.desktop_screenshot")
    json.src repository_prototype_build_screenshot_path \
      @repository.route_id,
      @prototype,
      @build.number,
      "desktop"
    json.darkSrc repository_prototype_build_screenshot_path \
      @repository.route_id,
      @prototype,
      @build.number,
      "desktop",
      theme: "dark"
  end

  json.narrowScreenshot do
    json.alt t("builds.show.narrow_screenshot_alt", number: @build.number)
    json.label t("builds.show.narrow_screenshot")
    json.src repository_prototype_build_screenshot_path \
      @repository.route_id,
      @prototype,
      @build.number,
      "narrow"
    json.darkSrc repository_prototype_build_screenshot_path \
      @repository.route_id,
      @prototype,
      @build.number,
      "narrow",
      theme: "dark"
  end
end

json.timelineHeading t("builds.show.timeline_heading")
json.createdAt @build.created_at.iso8601
json.createdLabel t("builds.show.created", time: l(@build.created_at, format: :long))

if @build.started_at
  json.startedAt @build.started_at.iso8601
  json.startedLabel t("builds.show.started", time: l(@build.started_at, format: :long))
end

if @build.finished_at
  json.finishedAt @build.finished_at.iso8601
  json.finishedLabel t("builds.show.finished", time: l(@build.finished_at, format: :long))
end

if @build.workflow_completed_at
  json.workflowCompletedAt @build.workflow_completed_at.iso8601
  json.workflowCompletedLabel t \
    "builds.show.workflow_completed",
    time: l(@build.workflow_completed_at, format: :long)
end

json.signOutLabel t("authenticated.sign_out")
json.accountMenuLabel t("authenticated.account_menu", login: Current.user.login)
json.signedInAsLabel t("authenticated.signed_in_as", login: Current.user.login)
json.signOutPath session_path
json.authenticityToken form_authenticity_token

json.currentUser do
  json.login Current.user.login
  json.name Current.user.name
  json.avatarUrl Current.user.avatar_url
end
