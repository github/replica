{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./app/javascript/*"],
      "@application/*": ["./app/javascript/application/*"],
      "@components/*": ["./app/javascript/components/*"],
      "@features/*": ["./app/javascript/features/*"],
      "@hooks/*": ["./app/javascript/hooks/*"],
      "@pages/*": ["./app/javascript/pages/*"],
      "@utils/*": ["./app/javascript/utils/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "app/javascript",
    ".react-router/types/**/*",
    "server",
    "test",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "eslint.config.ts",
    "prisma7.config.ts",
    "vite-aliases.ts",
    "controls-validator-plugin.ts",
    "mock-assets-plugin.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
