{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./client/*"],
      "@application/*": ["./client/application/*"],
      "@assets/*": ["./public/*"],
      "@components/*": ["./client/components/*"],
      "@features/*": ["./client/features/*"],
      "@hooks/*": ["./client/hooks/*"],
      "@pages/*": ["./client/pages/*"],
      "@utils/*": ["./client/utils/*"],
      "@replica-extension/*": ["../.github/extensions/replica-prototype/*"]
    },
    "resolveJsonModule": true,
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "client",
    ".react-router/types/**/*",
    "server",
    "script/**/*.ts",
    "test",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "eslint.config.ts",
    "prisma7.config.ts",
    "vite-aliases.ts",
    "controls-validator-plugin.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
