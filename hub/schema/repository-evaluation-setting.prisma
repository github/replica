model RepositoryEvaluationSetting {
  // ID columns
  id                               String  @id @default(uuid()) @db.Uuid
  repositoryId                     String  @unique @map("repository_id") @db.Uuid
  screenshotsChangedByMembershipId String? @map("screenshots_changed_by_membership_id") @db.Uuid

  // Relations
  repository                     Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  screenshotsChangedByMembership Membership? @relation(fields: [screenshotsChangedByMembershipId], references: [id], onDelete: SetNull)

  // Attribute columns
  enabled              Boolean   @default(false)
  evaluationGrantId    String?   @map("evaluation_grant_id") @db.VarChar(255)
  screenshotGrantId    String?   @map("screenshot_grant_id") @db.VarChar(255)
  screenshotsChangedAt DateTime? @map("screenshots_changed_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([screenshotsChangedByMembershipId])
  @@map("repository_evaluation_settings")
}
