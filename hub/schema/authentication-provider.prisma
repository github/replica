model AuthenticationProvider {
  // ID columns
  id                 String  @id @default(uuid()) @db.Uuid
  selectedRevisionId String? @unique @map("selected_revision_id") @db.Uuid

  // Relations
  revisions        AuthenticationProviderRevision[] @relation("AuthenticationProviderRevisions")
  selectedRevision AuthenticationProviderRevision?  @relation("SelectedAuthenticationProviderRevision", fields: [selectedRevisionId], references: [id], onDelete: Restrict)

  // Attribute columns
  key String @unique @db.VarChar(100)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("authentication_providers")
}

model AuthenticationProviderRevision {
  // ID columns
  id         String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  // Relations
  provider   AuthenticationProvider  @relation("AuthenticationProviderRevisions", fields: [providerId], references: [id], onDelete: Restrict)
  selectedBy AuthenticationProvider? @relation("SelectedAuthenticationProviderRevision")

  // Attribute columns
  revision            Int
  configurationDigest String @map("configuration_digest") @db.VarChar(64)
  settings            Json   @db.JsonB

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, revision])
  @@index([providerId])
  @@map("authentication_provider_revisions")
}
