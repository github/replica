model LearningScoreRequest {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid

  // Relations
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // Attribute columns
  commitSha String @map("commit_sha") @db.VarChar(64)
  // Raised by each repeat report, so scoring only drops the request version it read.
  revision  Int    @default(0)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([repositoryId, commitSha])
  @@index([createdAt])
  @@map("learning_score_requests")
}
