model SensitiveAuthorization {
  // ID columns
  id                 String @id @default(uuid()) @db.Uuid
  hubSessionId       String @map("hub_session_id") @db.Uuid
  actorMembershipId  String @map("actor_membership_id") @db.Uuid
  externalIdentityId String @map("external_identity_id") @db.Uuid

  // Relations
  hubSession           HubSession            @relation(fields: [hubSessionId], references: [id], onDelete: Restrict)
  actorMembership      Membership            @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)
  externalIdentity     ExternalIdentity      @relation(fields: [externalIdentityId], references: [id], onDelete: Restrict)
  authorizationAttempt AuthorizationAttempt?

  // Attribute columns
  operation                 SensitiveAuthorizationOperation
  targetMembershipIds       String[]                        @map("target_membership_ids") @db.Uuid
  expectedCopilotGeneration BigInt?                         @map("expected_copilot_generation")
  expiresAt                 DateTime                        @map("expires_at") @db.Timestamptz(3)
  verifiedAt                DateTime?                       @map("verified_at") @db.Timestamptz(3)
  continuedAt               DateTime?                       @map("continued_at") @db.Timestamptz(3)
  cancelledAt               DateTime?                       @map("cancelled_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([hubSessionId, expiresAt])
  @@index([actorMembershipId])
  @@map("sensitive_authorizations")
}
