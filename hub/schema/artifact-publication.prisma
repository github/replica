model ArtifactPublication {
  // ID columns
  id                  String @id @default(uuid()) @db.Uuid
  prototypeId         String @map("prototype_id") @db.Uuid
  workloadPublisherId String @map("workload_publisher_id") @db.Uuid
  prototypeVersionId  String @unique @map("prototype_version_id") @db.Uuid

  // Relations
  prototype         Prototype         @relation(fields: [prototypeId], references: [id], onDelete: Restrict)
  workloadPublisher WorkloadPublisher @relation(fields: [workloadPublisherId], references: [id], onDelete: Restrict)
  prototypeVersion  PrototypeVersion  @relation(fields: [prototypeVersionId], references: [id], onDelete: Restrict)

  // Attribute columns
  idempotencyKeyDigest String @map("idempotency_key_digest")
  requestDigest        String @map("request_digest")

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([workloadPublisherId, idempotencyKeyDigest])
  @@index([prototypeId])
  @@map("artifact_publications")
}
