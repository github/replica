model Prototype {
  // ID columns
  id             String  @id @default(uuid()) @db.Uuid
  repositoryId   String  @map("repository_id") @db.Uuid
  authorId       String? @map("author_id") @db.Uuid
  currentBuildId String? @map("current_build_id") @db.Uuid

  // Relations
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  author       User?      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  builds       Build[]    @relation("PrototypeBuilds")
  currentBuild Build?     @relation("CurrentPrototypeBuild", fields: [currentBuildId, id], references: [id, prototypeId], onDelete: Restrict)

  // Attribute columns
  branchName      String    @map("branch_name") @db.VarChar(255)
  name            String?   @db.VarChar(255)
  description     String?   @db.VarChar(500)
  startPage       String?   @map("start_page") @db.VarChar(2048)
  registeredAt    DateTime? @map("registered_at") @db.Timestamptz(3)
  branchDeletedAt DateTime? @map("branch_deleted_at") @db.Timestamptz(3)
  replica         Boolean   @default(false)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([repositoryId, registeredAt, id])
  @@index([authorId])
  @@map("prototypes")
}
