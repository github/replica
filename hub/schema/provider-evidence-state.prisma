model ProviderEvidenceState {
  // ID columns
  id                 String @id @default(uuid()) @db.Uuid
  externalIdentityId String @unique @map("external_identity_id") @db.Uuid

  // Relations
  externalIdentity ExternalIdentity @relation(fields: [externalIdentityId], references: [id], onDelete: Restrict)

  // Attribute columns
  lastIssuedAt DateTime @map("last_issued_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("provider_evidence_states")
}
