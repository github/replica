model GitHubBuildRunCompletion {
  // ID columns
  id      String @id @default(uuid()) @db.Uuid
  buildId String @map("build_id") @db.Uuid

  // Relations
  build Build @relation(fields: [buildId], references: [id], onDelete: Restrict)

  // Attribute columns
  githubWorkflowRunId BigInt   @map("github_workflow_run_id")
  runAttempt          Int      @map("run_attempt")
  completedAt         DateTime @map("completed_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([buildId, githubWorkflowRunId])
  @@map("github_build_run_completions")
}
