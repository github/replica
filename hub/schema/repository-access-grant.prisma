// A GitHub member's read access to a connected repository, refreshed at each
// sign-in and narrowed by GitHub webhooks.
model RepositoryAccessGrant {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid

  // Relations
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  // Timestamp columns
  observedAt DateTime @map("observed_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([membershipId, repositoryId])
  @@index([repositoryId])
  @@map("repository_access_grants")
}
