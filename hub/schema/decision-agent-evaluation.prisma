model DecisionAgentEvaluation {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid
  candidateId  String @map("candidate_id") @db.Uuid

  // Relations
  repository Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  candidate  DecisionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  // Attribute columns
  cacheKey            String   @map("cache_key") @db.Char(64)
  promotionGeneration BigInt   @map("promotion_generation")
  questionDigest      String   @map("question_digest") @db.VarChar(71)
  screenshotSetDigest String   @map("screenshot_set_digest") @db.VarChar(71)
  requestUnits        Int      @map("request_units")
  state               String   @db.VarChar(20)
  result              Json?    @db.JsonB
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([repositoryId, createdAt])
  @@index([cacheKey, createdAt])
  @@index([expiresAt])
  @@map("decision_agent_evaluations")
}
