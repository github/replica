model AuthenticationProviderRevision {
  // ID columns
  id         String @id @default(uuid()) @db.Uuid
  providerId String @map("provider_id") @db.Uuid

  // Relations
  provider              AuthenticationProvider  @relation("AuthenticationProviderRevisions", fields: [providerId], references: [id], onDelete: Restrict)
  selectedBy            AuthenticationProvider? @relation("SelectedAuthenticationProviderRevision")
  authorizationAttempts AuthorizationAttempt[]
  admissionHandoffs     AdmissionHandoff[]

  // Attribute columns
  revision            Int
  configurationDigest String @map("configuration_digest") @db.VarChar(64)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, revision])
  @@index([providerId])
  @@map("authentication_provider_revisions")
}
