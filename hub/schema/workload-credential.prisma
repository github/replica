model WorkloadCredential {
  // ID columns
  id                  String @id @default(uuid()) @db.Uuid
  workloadPublisherId String @map("workload_publisher_id") @db.Uuid

  // Relations
  workloadPublisher WorkloadPublisher @relation(fields: [workloadPublisherId], references: [id], onDelete: Restrict)

  // Attribute columns
  tokenDigest String    @unique @map("token_digest")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([workloadPublisherId])
  @@map("workload_credentials")
}
