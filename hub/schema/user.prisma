model User {
  // ID columns
  id String @id @default(uuid()) @db.Uuid
  canvasId Int @unique @default(autoincrement()) @map("canvas_id")

  // Relations
  externalIdentities     ExternalIdentity[]
  learningRuns           LearningRun[]
  membership             Membership?
  profile                UserProfile?
  prototypes             Prototype[]
  prototypeIntroductions PrototypeIntroduction[]
  reviewComments         ReviewComment[]
  resolvedReviewThreads  ReviewThread[]                @relation("ResolvedReviewThreads")
  reviewResolutionEvents ReviewThreadResolutionEvent[]
  reviewOutcomes         ReviewOutcome[]
  reviewReactions        ReviewReaction[]
  reviewThreadReads      ReviewThreadRead[]
  reviewNotifications    ReviewNotification[]
  shareLinks             ShareLink[]

  // Attribute columns
  welcomeHiddenAt DateTime? @map("welcome_hidden_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
