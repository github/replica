model CopilotConnectionState {
  // ID columns
  id String @id @default(uuid()) @db.Uuid

  // Attribute columns
  key                       String    @unique @default("global") @db.VarChar(20)
  generation                BigInt    @default(0)
  refusedCredentialProvider String?   @map("refused_credential_provider") @db.VarChar(100)
  refusedCredentialDigest   String?   @map("refused_credential_digest") @db.VarChar(64)
  refusedAt                 DateTime? @map("refused_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("copilot_connection_states")
}
