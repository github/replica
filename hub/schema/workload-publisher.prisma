model WorkloadPublisher {
  // ID columns
  id          String @id @default(uuid()) @db.Uuid
  prototypeId String @map("prototype_id") @db.Uuid

  // Relations
  prototype    Prototype             @relation(fields: [prototypeId], references: [id], onDelete: Restrict)
  credentials  WorkloadCredential[]
  versions     PrototypeVersion[]
  publications ArtifactPublication[]

  // Attribute columns
  name    String
  actions String[]
  active  Boolean  @default(true)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([prototypeId])
  @@map("workload_publishers")
}
