model Build {
  // ID columns
  id          String @id @default(uuid()) @db.Uuid
  prototypeId String @map("prototype_id") @db.Uuid

  // Relations
  prototype  Prototype   @relation("PrototypeBuilds", fields: [prototypeId], references: [id], onDelete: Restrict)
  currentFor Prototype[] @relation("CurrentPrototypeBuild")

  // Attribute columns
  number            Int
  state             BuildState @default(queued)
  workflowCreatedAt DateTime?  @map("workflow_created_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, prototypeId])
  @@unique([prototypeId, number])
  @@map("builds")
}
