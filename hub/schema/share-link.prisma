model ShareLink {
  // ID columns
  id          String @id @default(uuid()) @db.Uuid
  prototypeId String @map("prototype_id") @db.Uuid
  buildId     String @map("build_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid

  // Relations
  prototype Prototype @relation(fields: [prototypeId], references: [id], onDelete: Restrict)
  build     Build     @relation(fields: [buildId, prototypeId], references: [id, prototypeId], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  // Attribute columns
  publicId       String    @unique @map("public_id") @db.Uuid
  label          String    @db.VarChar(100)
  createdByLogin String    @map("created_by_login") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([prototypeId, createdAt, id])
  @@index([buildId])
  @@index([createdById])
  @@map("share_links")
}
