model HubSession {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid

  // Relations
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  // Attribute columns
  digest             String    @unique @db.VarChar(64)
  revocationRevision Int       @map("revocation_revision")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt            DateTime? @map("ended_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([membershipId, expiresAt])
  @@map("hub_sessions")
}
