model GitHubWebhookRecoveryCheckpoint {
  // ID columns
  appId   String  @id @map("app_id") @db.VarChar(100)
  leaseId String? @map("lease_id") @db.Uuid

  // Attribute columns
  cursor String? @db.VarChar(2048)

  // Timestamp columns
  leaseExpiresAt             DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  scanStartedAt              DateTime? @map("scan_started_at") @db.Timestamptz(3)
  lastCompletedScanStartedAt DateTime? @map("last_completed_scan_started_at") @db.Timestamptz(3)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("github_webhook_recovery_checkpoints")
}
