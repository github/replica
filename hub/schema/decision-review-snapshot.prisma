model DecisionReviewSnapshot {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @unique @map("repository_id") @db.Uuid

  // Relations
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // Attribute columns
  digest     String   @db.VarChar(71)
  snapshotId String   @map("snapshot_id") @db.Uuid
  capturedAt DateTime @map("captured_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("decision_review_snapshots")
}
