model Membership {
  // ID columns
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // Relations
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments             MembershipAssignment[]
  sessions                HubSession[]
  sensitiveAuthorizations SensitiveAuthorization[]
  repositoryAccessGrants  RepositoryAccessGrant[]
  copilotConnections      CopilotConnection[]

  // Attribute columns
  lifecycle MembershipLifecycle @default(ACTIVE)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([lifecycle])
  @@map("memberships")
}
