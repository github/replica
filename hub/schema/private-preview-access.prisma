model PrivatePreviewAccess {
  // ID columns
  id      String @id @default(uuid()) @db.Uuid
  buildId String @map("build_id") @db.Uuid

  // Relations
  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  // Attribute columns
  tokenDigest     String   @unique @map("token_digest") @db.Char(64)
  sessionDigest   String   @map("session_digest") @db.Char(64)
  readerOrigin    String   @map("reader_origin") @db.VarChar(255)
  challengeDigest String?  @map("challenge_digest") @db.Char(64)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([buildId])
  @@index([expiresAt])
  @@map("private_preview_accesses")
}
