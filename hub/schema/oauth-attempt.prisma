model OAuthAttempt {
  // ID columns
  id        String  @id @default(uuid()) @db.Uuid
  sessionId String? @map("session_id") @db.Uuid

  // Attribute columns
  stateDigest        String   @unique @map("state_digest")
  browserDigest      String   @map("browser_digest")
  verifier           String
  generation         Int
  credentialRevision String   @map("credential_revision")
  purpose            String
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oauth_attempts")
}
