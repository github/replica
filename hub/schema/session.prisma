model Session {
  // ID columns
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Attribute columns
  tokenDigest        String    @unique @map("token_digest")
  signedInAt         DateTime  @map("signed_in_at") @db.Timestamptz(3)
  freshAuthorizedAt  DateTime? @map("fresh_authorized_at") @db.Timestamptz(3)
  credentialRevision String    @map("credential_revision")

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}
