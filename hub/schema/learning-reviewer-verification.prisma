model LearningReviewerVerification {
  // ID columns
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid
  prototypeId  String @map("prototype_id") @db.Uuid

  // Relations
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  prototype  Prototype  @relation(fields: [prototypeId], references: [id], onDelete: Cascade)

  // Attribute columns
  commitSha  String   @map("commit_sha") @db.VarChar(64)
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([prototypeId, commitSha])
  @@index([repositoryId, commitSha])
  @@map("learning_reviewer_verifications")
}
