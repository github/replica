model AuthorizationAttempt {
  // ID columns
  id                 String @id @default(uuid()) @db.Uuid
  providerRevisionId String @map("provider_revision_id") @db.Uuid

  // Relations
  providerRevision AuthenticationProviderRevision @relation(fields: [providerRevisionId], references: [id], onDelete: Restrict)

  // Attribute columns
  purpose                AuthorizationAttemptPurpose
  bootstrapSecretDigest  String?                     @map("bootstrap_secret_digest") @db.Char(64)
  stateDigest            String                      @unique @map("state_digest") @db.VarChar(64)
  browserBindingDigest   String                      @map("browser_binding_digest") @db.VarChar(64)
  codeVerifierCiphertext String                      @map("code_verifier_ciphertext") @db.VarChar(500)
  expiresAt              DateTime                    @map("expires_at") @db.Timestamptz(3)
  consumedAt             DateTime?                   @map("consumed_at") @db.Timestamptz(3)

  // Timestamp columns
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([consumedAt])
  @@map("authorization_attempts")
}
