{
  "$schema": "./checks.schema.json",
  "version": 2,
  "base": "main",
  "concurrency": 1,
  "pages": [
    {
      "id": "home",
      "name": "Start page",
      "route": "/",
      "inputs": [
        "src/routes/home/**",
        "src/app/**",
        "src/main.tsx",
        "src/vite-env.d.ts",
        "src/components/**",
        "src/styles/**",
        "package*.json",
        "tsconfig*.json",
        "vite*.ts",
        "eslint*",
        ".prettierrc*"
      ]
    },
    {
      "id": "about",
      "name": "About",
      "route": "/#/about",
      "inputs": [
        "src/routes/about/**",
        "src/app/**",
        "src/main.tsx",
        "src/vite-env.d.ts",
        "src/components/**",
        "src/styles/**",
        "package*.json",
        "tsconfig*.json",
        "vite*.ts",
        "eslint*",
        ".prettierrc*"
      ]
    },
    {
      "id": "activity",
      "name": "Activity",
      "route": "/#/activity",
      "inputs": [
        "src/routes/activity/**",
        "src/data/**",
        "src/app/**",
        "src/main.tsx",
        "src/vite-env.d.ts",
        "src/components/**",
        "src/styles/**",
        "package*.json",
        "tsconfig*.json",
        "vite*.ts",
        "eslint*",
        ".prettierrc*"
      ]
    }
  ],
  "ignore": [
    "README.md",
    "SETUP.md",
    ".gitignore",
    ".replica/**",
    ".agents/skills/**",
    ".agents/context-templates/**",
    ".github/workflows/**",
    ".github/mcp.json",
    ".github/README.md",
    "scripts/**",
    "scaffold-templates/**",
    "prototype-scaffold.config.mjs"
  ],
  "checks": [
    {
      "id": "github-a11y-source",
      "name": "Accessibility source review (GitHub example)",
      "runner": { "type": "agent", "instructions": ".replica/checks/github-a11y.md" },
      "targets": ["home", "about", "activity"],
      "context": ["AGENTS.md"],
      "automatic": false,
      "timeoutSeconds": 300,
      "criteria": [
        {
          "id": "semantics-and-names",
          "name": "Semantics and accessible names"
        },
        {
          "id": "keyboard-and-focus",
          "name": "Keyboard and focus"
        },
        {
          "id": "forms-and-feedback",
          "name": "Forms and feedback"
        },
        {
          "id": "content-and-motion",
          "name": "Content and motion"
        }
      ]
    },
    {
      "id": "github-code-quality-source",
      "name": "Code-quality source review (GitHub example)",
      "runner": { "type": "agent", "instructions": ".replica/checks/github-code-quality.md" },
      "targets": ["home", "about", "activity"],
      "context": ["AGENTS.md"],
      "automatic": false,
      "timeoutSeconds": 300,
      "criteria": [
        {
          "id": "typing-and-lint-patterns",
          "name": "Type safety and lint patterns"
        },
        {
          "id": "react-correctness",
          "name": "React hooks and state"
        },
        {
          "id": "errors-and-async",
          "name": "Errors and async behavior"
        },
        {
          "id": "maintainability",
          "name": "Maintainability"
        }
      ]
    }
  ]
}
