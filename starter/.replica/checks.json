{
  "version": 2,
  "concurrency": 1,
  "checks": [
    {
      "id": "github-a11y-source",
      "name": "Accessibility source review (GitHub example)",
      "runner": { "type": "agent", "instructions": ".replica/checks/github-a11y.md" },
      "inputs": {
        "include": [
          "src/routes/home/**",
          "src/routes/about/**",
          "src/routes/activity/**",
          "src/data/**",
          "src/app/**",
          "src/main.tsx",
          "src/vite-env.d.ts",
          "src/components/**",
          "src/styles/**",
          "package*.json",
          "tsconfig*.json",
          "vite*.ts",
          "eslint*",
          ".prettierrc*"
        ]
      },
      "context": ["AGENTS.md"],
      "automatic": false,
      "timeoutSeconds": 300,
      "criteria": [
        {
          "id": "semantics-and-names",
          "name": "Semantics and accessible names"
        },
        {
          "id": "keyboard-and-focus",
          "name": "Keyboard and focus"
        },
        {
          "id": "forms-and-feedback",
          "name": "Forms and feedback"
        },
        {
          "id": "content-and-motion",
          "name": "Content and motion"
        }
      ]
    },
    {
      "id": "lint",
      "name": "Lint",
      "runner": {
        "type": "command",
        "command": ["npm", "run", "lint"],
        "report": "exit-code",
        "failureExitCodes": [1]
      },
      "inputs": {
        "include": ["src/**", "scripts/**", "*.mjs", "*.ts", "package*.json", "tsconfig*.json"]
      },
      "automatic": false,
      "timeoutSeconds": 120
    }
  ]
}
