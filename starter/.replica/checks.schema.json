{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/github/replica/raw/main/.github/extensions/replica-prototype/checks-config/schema.v2.json",
  "title": "Replica prototype checks",
  "description": "Version 2 repository-owned prototype checks. Assessment inputs and supporting guidance are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "base", "checks"],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/text",
      "description": "Editor schema reference only. Replica never fetches this URI during validation or execution."
    },
    "version": { "const": 2 },
    "base": {
      "allOf": [{ "$ref": "#/$defs/text" }, { "not": { "pattern": "^-" } }],
      "description": "Explicit starting Git reference. Canvas pins its merge base with the current branch."
    },
    "pages": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/page" },
      "description": "Optional page dependency map. Repository-wide checks do not need pages."
    },
    "ignore": {
      "$ref": "#/$defs/filePatterns",
      "description": "Files excluded from page-impact discovery, not assessment scope or freshness."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/check" }
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2,
      "description": "Maximum concurrent background checks."
    },
    "debounceMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 30000,
      "description": "Quiet period before automatic checks are scheduled."
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u001f\\u007f]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": { "enum": ["constructor", "prototype", "__proto__"] }
    },
    "filePattern": {
      "allOf": [
        { "$ref": "#/$defs/text" },
        {
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))[^/\\\\?\\[\\]{}\\u0000-\\u001f\\u007f]+(?:/[^/\\\\?\\[\\]{}\\u0000-\\u001f\\u007f]+)*$"
        }
      ],
      "description": "Repository-relative path or * / ** pattern. Absolute paths, traversal, empty segments and other glob syntax are not supported."
    },
    "fileReference": {
      "allOf": [{ "$ref": "#/$defs/filePattern" }, { "not": { "pattern": "\\*" } }],
      "description": "One repository-relative guidance file, without glob patterns."
    },
    "filePatterns": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/filePattern" }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route", "inputs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "route": {
          "allOf": [
            { "$ref": "#/$defs/text" },
            { "pattern": "^/(?!/)", "not": { "pattern": "\\\\" } }
          ],
          "description": "Root-relative preview route, including a hash route when needed."
        },
        "inputs": {
          "allOf": [{ "$ref": "#/$defs/filePatterns" }],
          "minItems": 1,
          "description": "Page source and shared dependencies used to discover affected pages."
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "runner"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "runner": {
          "oneOf": [{ "$ref": "#/$defs/commandRunner" }, { "$ref": "#/$defs/agentRunner" }]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {
            "include": {
              "allOf": [{ "$ref": "#/$defs/filePatterns" }],
              "minItems": 1,
              "description": "Assessment source. Omit inputs to use page dependencies or captured repository files."
            },
            "exclude": { "$ref": "#/$defs/filePatterns" }
          }
        },
        "context": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fileReference" },
          "description": "Exact guidance files. Readable by the runner but excluded from required source coverage."
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "description": "Configured page IDs. Omit for repository-wide checks."
        },
        "automatic": {
          "type": "boolean",
          "default": false,
          "description": "Opt this check into automatic background execution while Canvas is open."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "criteria": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "$ref": "#/$defs/text" }
            }
          },
          "description": "Optional named expectations assessed once per check, not weighted scores."
        },
        "scenarios": {
          "type": "array",
          "maxItems": 50,
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "runner": {
                "properties": { "report": { "const": "exit-code" } },
                "required": ["report"]
              }
            }
          },
          "then": {
            "properties": { "criteria": { "maxItems": 0 } }
          }
        }
      ]
    },
    "commandRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image", "command"],
      "properties": {
        "type": { "const": "command" },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]{0,255}$",
          "description": "An already installed container image. Replica does not pull images."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/text" },
          "description": "Executable and arguments, run without a host shell."
        },
        "report": {
          "enum": ["json", "exit-code"],
          "default": "json",
          "description": "Structured version 2 JSON, or pass/fail from configured exit codes."
        },
        "failureExitCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 123,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 123 },
          "description": "Quality-failure exits in exit-code mode. Defaults to [1]; other nonzero exits are execution errors."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "failureExitCodes": true }, "required": ["failureExitCodes"] },
          "then": {
            "required": ["report"],
            "properties": { "report": { "const": "exit-code" } }
          }
        }
      ]
    },
    "agentRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instructions"],
      "properties": {
        "type": { "const": "agent" },
        "instructions": {
          "$ref": "#/$defs/fileReference",
          "description": "Exact repository file containing the source-review procedure."
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pageId", "viewport", "expectations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "pageId": {
          "$ref": "#/$defs/id",
          "description": "A configured page included in this check's targets, when targets are declared."
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
            "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
          }
        },
        "state": {
          "type": "object",
          "description": "Runner-owned JSON state. Serialized state must not exceed 16000 characters."
        },
        "expectations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
