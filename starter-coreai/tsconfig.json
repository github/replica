{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "types": ["node", "vite/client"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"],
      "@coreai-ds/react-components": ["../../packages/react-components/src/index.ts"]
    }
  },
  "include": ["app", "vite.config.ts", "react-router.config.ts", ".react-router/types"],
  "exclude": ["node_modules", "build"]
}
