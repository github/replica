{
  "name": "@coreai-ds/prototype",
  "version": "0.0.0",
  "private": true,
  "description": "CoreAI Sandbox prototype app",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "check:starter": "npm run type-check && npm run lint && npm test && npm run build",
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview --outDir dist",
    "type-check": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "rimraf build dist .react-router"
  },
  "dependencies": {
    "@griffel/react": "1.7.8",
    "@coreai-ds/react-components": "^0.12.0",
    "@fluentui/react-components": "^9.74.0",
    "@fluentui/react-icons": "^2.0.323",
    "@react-router/node": "7.18.4",
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "isbot": "5.1.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4",
    "use-local-storage": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bippy": "^0.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "react-grab": "^0.2.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
